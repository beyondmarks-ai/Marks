rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsUserDoc(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isPublicMedia() {
      return resource.data.visibility == "public";
    }

    function hasValidMediaVisibility() {
      return request.resource.data.visibility in ["public", "private"];
    }

    match /users/{uid} {
      allow read, create, update: if ownsUserDoc(uid);
      allow delete: if false;

      match /chats/{chatId} {
        allow read, create, update, delete: if ownsUserDoc(uid);
      }

      match /media/{mediaId} {
        allow get, list: if ownsUserDoc(uid) || isPublicMedia();
        allow create, update: if ownsUserDoc(uid) && hasValidMediaVisibility();
        allow delete: if ownsUserDoc(uid);
      }
    }

    match /{path=**}/media/{mediaId} {
      allow get, list: if isPublicMedia();
    }
  }
}
